# Non-secret local configuration. Secrets belong in the process environment or
# a secret manager, not in this file or a local .env file.
DATABASE_URL=postgresql://customer@localhost:5432/customer_product
BACKEND_URL=http://localhost:8000
AUTH_AUDIENCE=
AUTH_ROLE_BINDINGS={}
# For local-only runs, set AUTH_MODE=local and use this token. Keep Google OAuth
# in all deployed environments.
AUTH_MODE=local
LOCAL_AUTH_TOKEN=local-dev-token
