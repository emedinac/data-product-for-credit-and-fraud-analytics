# Copy this file to .env for local development. Never use these defaults for
# production. The application does not load .env automatically; host commands
# must run: set -a; source .env; set +a

# 1) Required local connection
# Host-run commands use localhost. Docker Compose overrides this with the
# postgres service hostname inside the containers.
DATABASE_URL=postgresql://customer:customer@localhost:5432/customer_product
PORT=8000
BACKEND_URL=http://localhost:8000

# 2) Authentication for /v1/* (required for API, loader, and Streamlit data)
# Recommended local mode: use this static token and an admin role for the demo.
AUTH_MODE=local
LOCAL_AUTH_TOKEN=change-me-local-token
AUTH_ROLE_BINDINGS='{"your-email@example.com":"admin"}'
ENABLE_GROUND_TRUTH=true

# Only needed when AUTH_MODE=google. Leave blank for local mode.
AUTH_AUDIENCE=
# Optional production-style consumer grants. When set, this replaces the role
# bindings above as the authoritative access list.
AUTH_CONSUMER_ENTITLEMENTS=

# 3) Local files and storage
STORAGE_BACKEND=local
LAKE_ROOT=lake
RAW_ROOT=raw_dev

# 4) Background worker behavior
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_RETRY_BASE_SECONDS=30
PROCESSING_JOB_LEASE_SECONDS=1800
PROCESSING_WORKER_POLL_SECONDS=2

# 5) Quality-gate thresholds
MAX_QUARANTINE_RATE=0.05
MAX_DUPLICATE_RATE=0.05
MAX_REFERENTIAL_INTEGRITY_FAILURE_RATE=0.0
MIN_REQUIRED_FIELD_COMPLETENESS=0.99
MAX_VOLUME_CHANGE_RATE=0.50
MAX_FRESHNESS_SECONDS=86400

# 6) Currency conversion used by the local processor
BASE_CURRENCY=USD
EXCHANGE_RATE_SOURCE=local-development
EXCHANGE_RATES='{"EUR":1.08,"GBP":1.27}'
EXCHANGE_RATE_MAX_AGE_SECONDS=86400
# Optional ISO timestamp; omitted means "now".
# EXCHANGE_RATE_TIMESTAMP=2026-01-01T00:00:00+00:00

# 7) Optional Compose-only settings
# API_PORT=8000
# GRAFANA_ANONYMOUS_ENABLED=false
# GRAFANA_DISABLE_LOGIN_FORM=false

# 8) Cloud/GCS settings — not needed for local runs; leave unset
# STORAGE_BUCKET=
# GCP_PROJECT_ID=
# BACKEND_TOKEN=

# Fake-data generation uses command-line flags, not environment variables.
# See RUN_LOCAL.md and fake_data_generation.py.
