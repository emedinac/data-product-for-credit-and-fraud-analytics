      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "targets": [
        {
          "expr": "customer_data_product_worker_heartbeat",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Exchange-rate failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "targets": [
        {
          "expr": "increase(customer_data_product_exchange_rate_failures_total[24h])",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Fraud events",
      "description": "Accepted fraud events and confirmed fraud events in the rolling hour.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "targets": [
        {
          "expr": "increase(customer_data_product_fraud_events_total[1h])",
          "refId": "A",
          "legendFormat": "Fraud events"
        },
        {
          "expr": "increase(customer_data_product_confirmed_fraud_events_total[1h])",
          "refId": "B",
          "legendFormat": "Confirmed fraud"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "title": "Fraud confirmation rate",
      "description": "Confirmed fraud events divided by accepted fraud events in the latest batch.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 46
      },
      "targets": [
        {
          "expr": "customer_data_product_fraud_confirmation_rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "title": "Quarantine rate",
      "description": "Quarantined records divided by all records examined in the latest batch. Quality limit: 5%.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 46
      },
      "targets": [
        {
          "expr": "customer_data_product_quarantine_rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Quarantined records by reason",
      "description": "Rolling 24-hour quarantine volume split by bounded quality issue type.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 54
      },
      "targets": [
        {
          "expr": "sum by (issue_type) (increase(customer_data_product_quarantine_issues_total[24h]))",
          "refId": "A",
          "legendFormat": "{{issue_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Distribution shift score",
      "description": "Maximum Jensen-Shannon divergence from the previous processed batch. 0 means stable; 1 means fully different.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 54
      },
      "targets": [
        {
          "expr": "customer_data_product_distribution_shift_score",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.2
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Distribution shift by dimension",
      "description": "Jensen-Shannon divergence for customer status, transaction status/country, merchant category, and fraud event type.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 62
      },
      "targets": [
        {
          "expr": "customer_data_product_distribution_shift_by_dimension",
          "refId": "A",
          "legendFormat": "{{dimension}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "title": "Volume anomaly vs limit",
      "description": "Absolute batch volume change. Quality limit: 50%.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 62
      },
      "targets": [
        {
          "expr": "customer_data_product_volume_change_ratio",
          "refId": "A",
          "legendFormat": "Observed volume change"
        },
        {
          "expr": "vector(0.5)",
          "refId": "B",
          "legendFormat": "Configured limit"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      }
    }
  ],
  "schemaVersion": 39,
  "title": "Customer Data Product",
  "time": {
    "from": "now-24h",
    "to": "now"
  }
}
