      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [{"expr": "customer_data_product_processing_queue_depth", "refId": "A"}]
    },
    {
      "title": "Worker heartbeat",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [{"expr": "customer_data_product_worker_heartbeat", "refId": "A"}]
