{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "title": "Batch processing duration",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "customer_data_product_processing_duration_seconds", "refId": "A"}]
    },
    {
      "title": "Freshness seconds",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "customer_data_product_freshness_seconds", "refId": "A"}]
    },
    {
      "title": "Quality failures",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "increase(customer_data_product_quality_failures_total[1h])", "refId": "A"}]
    },
    {
      "title": "Volume change ratio",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "customer_data_product_volume_change_ratio", "refId": "A"}]
    },
    {
      "title": "End-to-end SLA seconds",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [{"expr": "customer_data_product_end_to_end_sla_seconds", "refId": "A"}]
    },
    {
      "title": "Operational failures",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {"expr": "increase(customer_data_product_source_schema_drift_total[24h])", "refId": "A", "legendFormat": "Schema drift"},
